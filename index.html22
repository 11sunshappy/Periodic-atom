<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>원소 탐험 · 원자 모형</title>
<style>
:root{--bg:#080817;--panel:#111126;--panel2:#17152f;--text:#f5f4ff;--muted:#aaa8c5;--accent:#b98aff;--line:#302c50}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 40% 0%,#1a1740 0%,var(--bg) 55%);color:var(--text);font-family:system-ui,-apple-system,'Noto Sans KR',sans-serif;min-height:100vh;padding:22px}
header{max-width:1400px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}h1{font-size:clamp(23px,4vw,36px);margin:0;letter-spacing:-1px}h1 span{color:var(--accent)}.sub{color:var(--muted);font-size:13px;margin-top:6px}.search{background:#131229;color:white;border:1px solid #39345b;border-radius:12px;padding:12px 14px;width:min(260px,45vw);outline:none}.layout{max-width:1400px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px}.tablebox,.detail{background:#0d0c20cc;border:1px solid #282542;border-radius:18px;padding:14px;box-shadow:0 16px 50px #0003}.tablebox{overflow:auto}.table{display:grid;grid-template-columns:28px repeat(18,minmax(42px,1fr));gap:5px;min-width:850px}.grouphead{display:grid;grid-template-columns:28px repeat(18,minmax(42px,1fr));gap:5px;min-width:850px;margin-bottom:5px}.grouphead div{color:#aaa7c7;text-align:center;font-size:11px;padding:3px}.periodnum{color:#aaa7c7;font-size:11px;display:flex;align-items:center;justify-content:center}.series-inline{color:#cbb2ff;font-size:9px;text-align:center;align-self:center;justify-self:stretch;white-space:normal;line-height:1.2;padding:2px}.fblock{display:grid;grid-template-columns:110px repeat(15,minmax(42px,1fr));gap:5px;min-width:810px;margin-top:10px}.flabel{color:#cbb2ff;font-size:10px;display:flex;align-items:center;justify-content:center;text-align:center}.fblock .el{min-height:54px}.el{border:1px solid #2c2948;border-radius:8px;min-height:65px;padding:5px 4px;background:linear-gradient(145deg,#17152e,#111021);cursor:pointer;transition:.16s;position:relative;color:#fff;text-align:left}.el:hover{transform:translateY(-2px);border-color:#b98aff;box-shadow:0 0 14px #b98aff33}.el.selected{border:1.5px solid #d2a9ff;background:linear-gradient(145deg,#342151,#1c1732);box-shadow:0 0 18px #b98aff44}.el .num{font-size:9px;color:#aaa7c7}.el .sym{font-size:18px;font-weight:750;line-height:1.1}.el .name{font-size:8px;color:#bdbad2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{visibility:hidden}.series{margin:12px 0 4px;color:#aaa7c7;font-size:11px;min-width:810px}.detail{position:sticky;top:16px;height:max-content;min-height:620px}.detailtop{display:flex;justify-content:space-between;align-items:start}.symbolbig{font-size:70px;font-weight:800;color:#d1a8ff;line-height:1}.ename{font-size:20px;font-weight:700;margin-top:6px}.meta{color:#a9a5c5;font-size:12px;margin-top:3px}.atomwrap{margin:12px 0;background:radial-gradient(circle,#171333,#080817 68%);border:1px solid #2d2850;border-radius:15px;display:flex;justify-content:center;align-items:center;min-height:290px}.atom{width:290px;height:290px;max-width:100%}.shell{fill:none;stroke:#5b4d83;stroke-width:1.2;opacity:.8}.electron{fill:#83d9ff;filter:drop-shadow(0 0 4px #71caff)}.nucleus{fill:#ff6aab;filter:drop-shadow(0 0 7px #ff6aab)}.nucleusText{fill:#fff;font-size:10px;text-anchor:middle;dominant-baseline:middle;font-weight:700}.facts{display:grid;grid-template-columns:1fr 1fr;gap:8px}.fact{background:#181630;border:1px solid #2c2948;border-radius:10px;padding:10px}.fact .label{color:#9d99bd;font-size:11px}.fact .value{font-size:18px;font-weight:700;margin-top:3px}.shells{margin-top:12px;color:#c9c6e4;font-size:13px}.shellchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}.chip{border:1px solid #3c365f;background:#211d3b;padding:5px 9px;border-radius:99px;font-size:12px}.hint{color:#8c89a9;font-size:11px;margin-top:12px;line-height:1.6}.category{display:inline-block;border-radius:99px;padding:4px 8px;font-size:10px;margin-top:9px;background:#282347;color:#cbb2ff}.hidden{display:none!important}
@media(max-width:900px){body{padding:12px}.layout{grid-template-columns:1fr}.detail{position:relative;top:auto;min-height:unset}.atomwrap{min-height:260px}.atom{width:270px;height:270px}header{align-items:flex-start;flex-direction:column}.search{width:100%}}

.orbitalPanel{margin-top:14px;background:#100f24;border:1px solid #302c50;border-radius:14px;padding:14px}.orbitalTitle{font-weight:700;color:#d6b7ff;margin-bottom:8px}.electronConfig{font-size:13px;color:#e9ddff;line-height:1.7;word-break:break-word}.orbitalBoxes{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}.subshell{display:flex;flex-direction:column;align-items:center;gap:4px}.subshellLabel{font-size:11px;color:#aaa8c5}.orbitalRow{display:flex;gap:3px}.orbitalBox{width:25px;height:27px;border:1px solid #8d79bb;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#e8d6ff;font-size:15px;background:#201b39}.orbitalNote{font-size:10px;color:#8f8ba9;margin-top:9px}
</style></head>
<body>
<header><div><h1>원소 <span>탐험</span></h1><div class="sub">주기율표에서 원소를 선택하면 원자 모형과 전자 배치를 볼 수 있어요.</div></div><input id="search" class="search" placeholder="원소 이름 또는 기호 검색 (예: 산소, O)" autocomplete="off"></header>
<div class="layout"><section class="tablebox"><div id="grouphead" class="grouphead"></div><div id="ptable" class="table"></div><div id="fblock" class="fblock"></div></section>
<aside class="detail"><div class="detailtop"><div><div id="bigSymbol" class="symbolbig">H</div><div id="elName" class="ename">수소</div><div id="elMeta" class="meta">원자번호 1 · 1주기</div><div id="cat" class="category">비금속</div></div></div><div class="atomwrap"><svg id="atom" class="atom" viewBox="0 0 300 300" aria-label="선택한 원소의 원자 모형"></svg></div><div class="facts"><div class="fact"><div class="label">양성자</div><div class="value" id="protons">1</div></div><div class="fact"><div class="label">전자</div><div class="value" id="electrons">1</div></div><div class="fact"><div class="label">주기</div><div class="value" id="period">1</div></div><div class="fact"><div class="label">족</div><div class="value" id="group">1</div></div></div><div class="shells">전자껍질 배치<div id="shellchips" class="shellchips"></div></div><div class="orbitalPanel"><div class="orbitalTitle">오비탈 전자 배치</div><div id="electronConfig" class="electronConfig"></div><div id="orbitalBoxes" class="orbitalBoxes"></div><div class="orbitalNote">상자 하나는 오비탈 1개, 화살표는 전자 1개를 나타냅니다.</div></div><div class="hint">※ 원자 모형은 전자를 껍질에 배치한 보어 모형식 표현입니다. 전자 배치는 일부 원소에서 실제 예외와 다를 수 있어 학습용으로 단순화했습니다.</div></aside></div>
<script>
const names=`수소 헬륨 리튬 베릴륨 붕소 탄소 질소 산소 플루오린 네온 나트륨 마그네슘 알루미늄 규소 인 황 염소 아르곤 칼륨 칼슘 스칸듐 티타늄 바나듐 크로뮴 망가니즈 철 코발트 니켈 구리 아연 갈륨 게르마늄 비소 셀레늄 브로민 크립톤 루비듐 스트론튬 이트륨 지르코늄 나이오븀 몰리브데넘 테크네튬 루테늄 로듐 팔라듐 은 카드뮴 인듐 주석 안티몬 텔루륨 아이오딘 제논 세슘 바륨 란타넘 세륨 프라세오디뮴 네오디뮴 프로메튬 사마륨 유로퓸 가돌리늄 터븀 디스프로슘 홀뮴 에르븀 툴륨 이터븀 루테튬 하프늄 탄탈럼 텅스텐 레늄 오스뮴 이리듐 백금 금 수은 탈륨 납 비스무트 폴로늄 아스타틴 라돈 프랑슘 라듐 악티늄 토륨 프로트악티늄 우라늄 넵투늄 플루토늄 아메리슘 퀴륨 버클륨 캘리포늄 아인슈타이늄 페르뮴 멘델레븀 노벨륨 로렌슘 러더포듐 더브늄 시보귬 보륨 하슘 마이트너륨 다름슈타튬 뢴트겐륨 코페르니슘 니호늄 플레로븀 모스코븀 리버모륨 테네신 오가네손`.split(' ');
const syms=`H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe Cs Ba La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn Fr Ra Ac Th Pa U Np Pu Am Cm Bk Cf Es Fm Md No Lr Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og`.split(' ');
const periods=[['H',...Array(16).fill(''),'He'],['Li','Be',...Array(10).fill(''),'B','C','N','O','F','Ne'],['Na','Mg',...Array(10).fill(''),'Al','Si','P','S','Cl','Ar'],['K','Ca','Sc','Ti','V','Cr','Mn','Fe','Co','Ni','Cu','Zn','Ga','Ge','As','Se','Br','Kr'],['Rb','Sr','Y','Zr','Nb','Mo','Tc','Ru','Rh','Pd','Ag','Cd','In','Sn','Sb','Te','I','Xe'],['Cs','Ba','','Hf','Ta','W','Re','Os','Ir','Pt','Au','Hg','Tl','Pb','Bi','Po','At','Rn'],['Fr','Ra','','Rf','Db','Sg','Bh','Hs','Mt','Ds','Rg','Cn','Nh','Fl','Mc','Lv','Ts','Og']];
const lanth=`La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu`.split(' '), act=`Ac Th Pa U Np Pu Am Cm Bk Cf Es Fm Md No Lr`.split(' ');
const map=new Map(syms.map((s,i)=>[s,{z:i+1,sym:s,name:names[i]}]));
function periodOf(z){return z<=2?1:z<=10?2:z<=18?3:z<=36?4:z<=54?5:z<=86?6:7}
function groupOf(sym){for(let r of periods){let i=r.indexOf(sym);if(i>=0)return i+1}if(lanth.includes(sym))return 3;if(act.includes(sym))return 3;return 0}
function cat(z){if([2,10,18,36,54,86,118].includes(z))return '비활성 기체';if([9,17,35,53,85,117].includes(z))return '할로젠';if([3,11,19,37,55,87].includes(z))return '알칼리 금속';if([4,12,20,38,56,88].includes(z))return '알칼리 토금속';if(z===1||[6,7,8,15,16,34].includes(z))return '비금속';if([5,14,32,33,51,52].includes(z))return '준금속';if(z>=57&&z<=71)return '란타넘족';if(z>=89&&z<=103)return '악티늄족';if(z>=104)return '전이 금속';if(z>=21&&z<=30||z>=39&&z<=48||z>=72&&z<=80)return '전이 금속';return '금속'}
// approximate shell counts by filling orbitals in standard sequence
const orbital=[['1s',2],['2s',2],['2p',6],['3s',2],['3p',6],['4s',2],['3d',10],['4p',6],['5s',2],['4d',10],['5p',6],['6s',2],['4f',14],['5d',10],['6p',6],['7s',2],['5f',14],['6d',10],['7p',6]];
function shells(z){let counts=[0,0,0,0,0,0,0];for(const [orb,n] of orbital){if(z<=0)break;let take=Math.min(z,n);let shell=Number(orb[0]);counts[shell-1]+=take;z-=take;}return counts.filter(x=>x>0)}
function makeCell(sym,container,gridRow,gridCol){let e=map.get(sym);if(!e)return;let el=document.createElement('button');el.className='el';el.dataset.sym=sym;el.style.gridRow=gridRow;el.style.gridColumn=gridCol+1;el.innerHTML=`<div class="num">${e.z}</div><div class="sym">${sym}</div><div class="name">${e.name}</div>`;el.onclick=()=>select(e);container.appendChild(el)}
const gh=document.getElementById('grouphead');gh.innerHTML='<div></div>'+Array.from({length:18},(_,i)=>`<div>${i+1}족</div>`).join('');
periods.forEach((row,r)=>{let pn=document.createElement('div');pn.className='periodnum';pn.style.gridRow=r+1;pn.style.gridColumn=1;pn.textContent=`${r+1}주기`;document.getElementById('ptable').appendChild(pn);row.forEach((sym,c)=>{if(sym)makeCell(sym,document.getElementById('ptable'),r+1,c+1)});if(r===5||r===6){let label=document.createElement('div');label.className='series-inline';label.style.gridRow=r+1;label.style.gridColumn=4;label.textContent=r===5?'란타넘족':'악티늄족';document.getElementById('ptable').appendChild(label);}});
const fblock=document.getElementById('fblock');[['란타넘족',lanth],['악티늄족',act]].forEach(([label,series],r)=>{let t=document.createElement('div');t.className='flabel';t.style.gridRow=r+1;t.style.gridColumn=1;t.textContent=label;fblock.appendChild(t);series.forEach((sym,i)=>makeCell(sym,fblock,r+1,i+2));});

const subOrder=[['1s',2],['2s',2],['2p',6],['3s',2],['3p',6],['4s',2],['3d',10],['4p',6],['5s',2],['4d',10],['5p',6],['6s',2],['4f',14],['5d',10],['6p',6],['7s',2],['5f',14],['6d',10],['7p',6]];
function orbitalData(z,sym){let occ={};let left=z;for(const [name,cap] of subOrder){if(left<=0)break;occ[name]=Math.min(cap,left);left-=occ[name];}
// Common ground-state exceptions, handled by shifting one electron from the outer s to d subshell.
const exceptions={Cr:['4s','3d',1],Cu:['4s','3d',1],Mo:['5s','4d',1],Ag:['5s','4d',1],Au:['6s','5d',1]};
if(exceptions[sym]){let [sOrb,dOrb,n]=exceptions[sym];occ[sOrb]=(occ[sOrb]||0)-n;occ[dOrb]=(occ[dOrb]||0)+n;}
let config=subOrder.filter(([name])=>occ[name]>0).map(([name])=>`${name}<sup>${occ[name]}</sup>`).join(' ');
let boxes=subOrder.filter(([name])=>occ[name]>0).map(([name,cap])=>{let count=occ[name],slots=cap/2,arr=Array(slots).fill('');for(let i=0;i<Math.min(count,slots);i++)arr[i]='↑';for(let i=slots;i<count;i++)arr[i-slots]='↑↓';return {name,arr}});return {config,boxes};}
function renderOrbitals(e){let data=orbitalData(e.z,e.sym);document.getElementById('electronConfig').innerHTML=data.config;document.getElementById('orbitalBoxes').innerHTML=data.boxes.map(o=>`<div class="subshell"><div class="subshellLabel">${o.name}</div><div class="orbitalRow">${o.arr.map(a=>`<div class="orbitalBox">${a}</div>`).join('')}</div></div>`).join('');}

function select(e){document.querySelectorAll('.el').forEach(x=>x.classList.toggle('selected',x.dataset.sym===e.sym));let p=periodOf(e.z),g=groupOf(e.sym),sh=shells(e.z);document.getElementById('bigSymbol').textContent=e.sym;document.getElementById('elName').textContent=e.name;document.getElementById('elMeta').textContent=`원자번호 ${e.z} · ${p}주기`;document.getElementById('cat').textContent=cat(e.z);document.getElementById('protons').textContent=e.z;document.getElementById('electrons').textContent=e.z;document.getElementById('period').textContent=p;document.getElementById('group').textContent=g===0?'별도 분류':g;document.getElementById('shellchips').innerHTML=sh.map((n,i)=>`<span class="chip">${i+1}껍질 · ${n}개</span>`).join('');drawAtom(e,sh);renderOrbitals(e);}
function drawAtom(e,sh){let svg=document.getElementById('atom');svg.innerHTML='';const cx=150,cy=150;let maxR= Math.min(112,24+sh.length*15);sh.forEach((count,i)=>{let r=30+i*(maxR/(sh.length||1));let ring=document.createElementNS('http://www.w3.org/2000/svg','circle');ring.setAttribute('cx',cx);ring.setAttribute('cy',cy);ring.setAttribute('r',r);ring.setAttribute('class','shell');svg.appendChild(ring);for(let j=0;j<count;j++){let angle=2*Math.PI*j/count-Math.PI/2;let dot=document.createElementNS('http://www.w3.org/2000/svg','circle');dot.setAttribute('cx',cx+r*Math.cos(angle));dot.setAttribute('cy',cy+r*Math.sin(angle));dot.setAttribute('r',4);dot.setAttribute('class','electron');svg.appendChild(dot)}});let nucleus=document.createElementNS('http://www.w3.org/2000/svg','circle');nucleus.setAttribute('cx',cx);nucleus.setAttribute('cy',cy);nucleus.setAttribute('r',17);nucleus.setAttribute('class','nucleus');svg.appendChild(nucleus);let text=document.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('x',cx);text.setAttribute('y',cy);text.setAttribute('class','nucleusText');text.textContent=e.z+'p';svg.appendChild(text)}
select(map.get('H'));
const search=document.getElementById('search');search.addEventListener('input',()=>{let q=search.value.trim().toLowerCase();document.querySelectorAll('.el').forEach(el=>{let e=map.get(el.dataset.sym);el.classList.toggle('hidden',!!q&&!(`${e.sym} ${e.name} ${e.z}`.toLowerCase().includes(q)))})});
</script></body></html>
